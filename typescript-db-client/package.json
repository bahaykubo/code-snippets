{
  "name": "db-client",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "ci": "rm -rf node_modules && npm ci",
    "lint": "eslint . && prettier --check .",
    "lint-fix": "eslint . --fix && prettier --write . && npm run lint",
    "build": "tsc",
    "test": "mocha",
    "test-parallel": "mocha --parallel",
    "test-grep": "mocha tests --grep",
    "test-grep-parallel": "mocha tests --parallel --grep",
    "test-watch": "mocha --watch",
    "start-seed-db": "./scripts/start-db.sh && ts-node -r tsconfig-paths/register ./services/utilities/seed-db.ts"
  },
  "dependencies": {
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.21.2"
  },
  "devDependencies": {
    "@types/chai": "^4.3.9",
    "@types/mocha": "^10.0.3",
    "@types/node": "^20.8.10",
    "@types/pg": "^8.10.9",
    "chai": "^4.3.10",
    "eslint-plugin-mocha": "^11.3.0",
    "mocha": "^10.2.0",
    "mochawesome": "^7.1.3",
    "style-lint-js": "^3.0.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  }
}
