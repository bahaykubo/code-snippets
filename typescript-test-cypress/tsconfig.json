{
  "compilerOptions": {
    "outDir": "dist",
    "module": "es2020",
    "target": "es2021",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "@config/*": ["./config/*"],
      "@constant/*": ["./constants/*"],
      "@page/*": ["./pages/*"],
      "@service/*": ["./services/*"],
      "@type/*": ["./types/*"]
    }
  },
  "exclude": ["node_modules", "./.github", "./.vscode"]
}
